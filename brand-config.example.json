        "vocabulary": [
          "pipeline gap",
          "SDR ramp",
          "we keep closing wrong-fit logos"
        ]
      }
    ],
    "competitors": [
      {"name": "Competitor X", "list_price": "$499/mo", "psp_overlap": "partial"}
